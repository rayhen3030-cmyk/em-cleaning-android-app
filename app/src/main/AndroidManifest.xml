<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet für Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Kamera für Fenster-/AR-Messung -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Kamera ist hilfreich, aber App kann grundsätzlich auch ohne installiert werden -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="E-M Cleaning"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- Haupt-App -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <!-- Fenster-/Kamera-Messung -->
        <activity
            android:name=".MeasureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
